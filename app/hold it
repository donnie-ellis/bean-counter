        <div className="flex items-center justify-between">
          <CardTitle className="text-xs uppercase tracking-widest text-slate-500">This Week</CardTitle>
          <span className="font-mono text-xs text-slate-500">
            Total <span className="text-slate-300">${weekTotal}</span>
          </span>
        </div>
      </CardHeader>
      <CardContent>
        <ResponsiveContainer width="100%" height={110}>
          <BarChart data={weeklyData} barSize={22} margin={{ top: 4, right: 0, left: -28, bottom: 0 }}>
            <XAxis dataKey="day"
              tick={{ fill: "#475569", fontSize: 11, fontFamily: "monospace" }}
              axisLine={false} tickLine={false} />
            <YAxis tick={{ fill: "#334155", fontSize: 10 }} axisLine={false} tickLine={false} />
            <Tooltip content={<CustomTooltip />} cursor={false} />
            <Bar dataKey="amount" radius={[4, 4, 0, 0]}>
              {weeklyData.map((d, i) => (
                <Cell key={i} fill={d.day === maxDay.day ? "#f59e0b" : "#1e3a5f"} />
              ))}
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </CardContent>
